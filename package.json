{
  "name": "sombra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('fs').writeFileSync('node_modules/.package-lock-hash',require('crypto').createHash('sha256').update(require('fs').readFileSync('package-lock.json')).digest('hex'))\"",
    "check-deps": "node -e \"const f=require('fs'),c=require('crypto');const want=c.createHash('sha256').update(f.readFileSync('package-lock.json')).digest('hex');let have;try{have=f.readFileSync('node_modules/.package-lock-hash','utf8')}catch{}if(want!==have){console.error('node_modules is out of sync with package-lock.json.\\nRun: rm -rf node_modules && npm install');process.exit(1)}\"",
    "tokens": "tsx scripts/generate-tokens.ts",
    "tokens:pull": "tsx scripts/figma-pull.ts",
    "tokens:check": "tsx scripts/generate-tokens.ts --check",
    "tokens:sync": "npm run tokens:pull && npm run tokens",
    "tokens:audit": "tsx scripts/figma-audit.ts",
    "audit:collect": "tsx scripts/audit-collect.ts",
    "audit:visual": "tsx scripts/visual-audit.ts",
    "audit:hero": "tsx scripts/token-hero-audit.ts",
    "audit:full": "npm run audit:collect && npm run tokens:audit && npm run audit:visual",
    "drift:collect": "tsx scripts/drift-collect.ts",
    "drift:check": "tsx scripts/drift-check.ts",
    "icons:seed": "tsx scripts/generate-icons.ts seed",
    "icons:add": "tsx scripts/generate-icons.ts add",
    "icons:gen": "tsx scripts/generate-icons.ts gen",
    "icons:gen:check": "tsx scripts/generate-icons.ts gen --check",
    "icons:verify": "tsx scripts/verify-icons.ts",
    "build:info": "tsx scripts/generate-build-info.ts",
    "predev": "npm run check-deps && npm run build:info && npm run tokens",
    "prebuild": "npm run check-deps && npm run build:info && npm run tokens",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:embed",
    "lint": "eslint .",
    "preview": "vite preview",
    "self-validate": "tsx scripts/self-validate/index.ts",
    "self-validate:fast": "tsx scripts/self-validate/index.ts --no-gpu",
    "blur:test": "tsx scripts/blur-bakeoff/test.ts",
    "verify:wired-branch": "tsx scripts/verify-wired-texture-branch.ts",
    "verify:raw-budget": "tsx scripts/verify-raw-budget.ts",
    "verify:ir-control-flow": "tsx scripts/verify-ir-control-flow.ts",
    "verify:pass-size": "tsx scripts/verify-pass-size.ts",
    "verify:pass-resolution": "tsx scripts/verify-pass-resolution.ts",
    "verify:pass-resolution:gpu": "tsx scripts/verify-pass-resolution-gpu.ts",
    "verify:coord-contract:gpu": "tsx scripts/verify-coord-contract-gpu.ts",
    "verify:frame-scale-invariance": "tsx scripts/verify-frame-scale-invariance.ts",
    "verify:ir-poc": "tsx scripts/verify-ir-poc.ts",
    "verify:wgsl-multipass": "tsx scripts/validate-wgsl-multipass.ts",
    "verify:video-export": "tsx scripts/verify-video-export.ts",
    "verify:export-destination": "tsx scripts/verify-export-destination.ts",
    "verify:export-streaming": "tsx scripts/verify-export-streaming.ts",
    "verify:export-opfs": "tsx scripts/verify-export-opfs.ts",
    "verify:export-abort": "tsx scripts/verify-export-abort.ts",
    "verify:node-id": "tsx scripts/verify-node-id.ts",
    "verify:sombra-package": "tsx scripts/verify-sombra-package.ts",
    "verify:file-drop": "tsx scripts/verify-file-drop.ts",
    "verify:stream-integrity": "tsx scripts/verify-stream-integrity.ts",
    "verify:stream-fixes": "tsx scripts/verify-stream-fixes.ts",
    "verify:coord-hygiene": "tsx scripts/verify-coord-hygiene.ts",
    "verify:wgsl-mod": "tsx scripts/verify-wgsl-mod.ts",
    "verify:srt": "tsx scripts/verify-srt.ts",
    "verify:srt-conformity": "tsx scripts/verify-srt-conformity.ts",
    "verify:ci": "npm run verify:ir-poc && npm run verify:wgsl-multipass && npm run verify:raw-budget && npm run verify:pass-size && npm run verify:pass-resolution && npm run verify:ir-control-flow && npm run verify:wired-branch && npm run verify:node-id && npm run verify:sombra-package && npm run verify:file-drop && npm run verify:stream-fixes && npm run verify:wgsl-mod && npm run verify:srt && npm run verify:srt-conformity",
    "build:embed": "vite build --config vite.embed.config.ts",
    "verify:embed:artifact": "tsx scripts/verify-artifact-roundtrip.ts",
    "verify:embed:manifest": "tsx scripts/verify-manifest.ts",
    "verify:embed:bundle": "tsx scripts/verify-embed-bundle.ts",
    "verify:embed:snippets": "tsx scripts/verify-embed-snippets.ts",
    "verify:embed:smoke": "tsx scripts/verify-embed-smoke.ts",
    "verify:embed:fwd": "tsx scripts/verify-embed-forward-compat.ts",
    "verify:embed": "npm run verify:embed:artifact && npm run verify:embed:manifest && npm run verify:embed:snippets"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@fontsource/inter": "^5.3.0",
    "@types/pako": "^2.0.4",
    "@xyflow/react": "^12.10.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "mediabunny": "^1.53.1",
    "pako": "^2.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.6.4",
    "tailwind-merge": "^3.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/dagre": "^0.7.53",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "lucide-static": "^1.31.0",
    "playwright-core": "^1.61.1",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "zod": "^4.3.6"
  }
}
